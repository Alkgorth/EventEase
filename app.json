{
  "expo": {
    "name": "EventEase",
    "slug": "EventEase",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo_reference.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/logo_reference.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4F1DE"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F4F1DE",
        "foregroundImage": "./assets/images/logo_reference.png"
      },
      "splash": {
        "image": "./assets/images/logo_reference-SplashScreen.png",
        "resizeMode": "contain",
        "backgroundColor": "#F4F1DE"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/images/miniature_EventEase2.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F1DE",
          "image": "./assets/images/logo_reference-SplashScreen.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ]
    ]
  }
}
